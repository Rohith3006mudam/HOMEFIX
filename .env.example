VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required for live Google Maps tracking (LiveTrackingMap.jsx / GoogleMap.jsx).
# Without it the app falls back to a no-map placeholder; it is never invented.
VITE_GOOGLE_MAPS_API_KEY=
# Public Razorpay checkout key only. Keep RAZORPAY_KEY_SECRET in Supabase
# Edge Function secrets; never put it in a VITE_ variable.
VITE_RAZORPAY_KEY_ID=
VITE_PUBLIC_SITE_URL=https://YOUR-DOMAIN.com
